# 复制为 .env 并填入真实值（.env 已在 .gitignore 里，不会提交到 GitHub）
# AppID/AppSecret 在微信公众平台 → 开发管理 → 开发设置 获取
WECHAT_APPID=你的小程序AppID
WECHAT_SECRET=你的小程序AppSecret

# 可选：严格模式，检测结果为“review（疑似）”时也拦截。默认只拦截 risky。
# CONTENT_SECURITY_STRICT=1

# 一起看功能：微信「消息推送」的 Token 和 EncodingAESKey（启用消息推送时生成）
# 服务器对外域名（默认 https://lxl-qwx.xyz，供 mediaCheckAsync 提供可访问的视频地址）
# WECHAT_PUSH_TOKEN=
# WECHAT_PUSH_AES_KEY=
# PUBLIC_BASE_URL=https://lxl-qwx.xyz

# 可选：单个视频大小上限（字节，默认 1GB）
# MAX_VIDEO_BYTES=1073741824

# 可选：把数据目录（数据库+上传文件）指到别处。本地开发在微信开发者工具项目目录里
# 启动后端时必须设置（如 DATA_DIR=D:/love-data），否则工具会监听到文件变化反复重编译。
# DATA_DIR=D:/love-data
